[Unit]
Description=AC820 GT911 touch pinctrl correction
Wants=sys-kernel-config.mount sys-kernel-debug.mount
After=sys-kernel-config.mount sys-kernel-debug.mount systemd-udev-trigger.service
Before=jupyter.service pl_server.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/sbin/ac820-touch-pinctrl.py
RemainAfterExit=yes
TimeoutStartSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
